<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<!-- Root container -->
<AnchorPane fx:id="openArea" xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.lottooptionspro.controller.DashBoardController">
    <stylesheets>
        <URL value="@styling/dashboard.css"/>
        <URL value="@styling/style.css"/>
        <URL value="@styling/trading-chart.css"/>
    </stylesheets>

    <VBox AnchorPane.topAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.bottomAnchor="5.0">
        <!-- Top controls -->
        <HBox spacing="5" style="-fx-padding: 0 0 5 0;">
            <Button fx:id="segmentViewBtn" text="Segment View" onAction="#handleToggleSegmentView" styleClass="nav-button">
                <tooltip>
                    <Tooltip text="Toggle segment analysis view"/>
                </tooltip>
            </Button>
            <Button fx:id="tradingChartBtn" text="Trading Chart" onAction="#handleToggleTradingChart" styleClass="nav-button">
                <tooltip>
                    <Tooltip text="Toggle position trend analysis"/>
                </tooltip>
            </Button>
            <Button fx:id="patternAnalysisBtn" text="Pattern Analysis" onAction="#handleTogglePatternAnalysis" styleClass="nav-button">
                <tooltip>
                    <Tooltip text="Toggle between Frequency and Pattern Analysis"/>
                </tooltip>
            </Button>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="removeBtn" text="&lt;" onAction="#handleRemoveRow" minWidth="30" prefWidth="30" prefHeight="30" minHeight="30" styleClass="nav-button">
                <tooltip>
                    <Tooltip text="Back in time"/>
                </tooltip>
            </Button>
            <Button fx:id="addBtn" text="&gt;" onAction="#handleAddRow" minWidth="30" prefWidth="30" prefHeight="30" minHeight="30" styleClass="nav-button">
                <tooltip>
                    <Tooltip text="Forward in time"/>
                </tooltip>
            </Button>
        </HBox>

        <!-- Main content area with table on left and frequency analysis on right -->
        <HBox VBox.vgrow="ALWAYS" spacing="10">
            <!-- Left side: Draw history tables -->
            <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                <HBox VBox.vgrow="ALWAYS" styleClass="table-container">
                    <TableView fx:id="dateColumnTable" prefWidth="120" minWidth="120" maxWidth="120" editable="true">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <!-- The "Draw Date" column will be added here by the controller -->
                        </columns>
                    </TableView>
                    <TableView fx:id="numberColumnsTable" HBox.hgrow="ALWAYS" editable="true">
                        <columns>
                            <!-- The number columns will be added here by the controller -->
                        </columns>
                    </TableView>
                </HBox>
                
                <!-- Data Table Legend -->
                <HBox fx:id="legendContainer" spacing="10" style="-fx-padding: 10 0 0 0;" alignment="CENTER_LEFT"/>
            </VBox>
            
            <!-- Right side: Games Out Frequency Analysis -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" prefWidth="350" minWidth="300" maxWidth="400">
                <VBox fx:id="gamesOutFrequencyContainer" spacing="5" style="-fx-padding: 0;" visible="true" managed="true"/>
            </ScrollPane>
        </HBox>

        <!-- Probability panes container (does not grow) -->
        <HBox fx:id="dynamicPanesContainer" spacing="10" />
        
        <!-- Pattern Analysis Container (initially hidden) -->
        <VBox fx:id="patternAnalysisContainer" spacing="10" style="-fx-padding: 10 0 0 0;" visible="false" managed="false" maxHeight="600">
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" prefHeight="550" maxHeight="550">
                <VBox fx:id="patternAnalysisContent" spacing="5" style="-fx-padding: 10;"/>
            </ScrollPane>
        </VBox>

        <!-- Trading Chart Analysis Container (initially hidden) -->
        <VBox fx:id="tradingChartContainer" spacing="10" style="-fx-padding: 10 0 0 0;" visible="false" managed="false" VBox.vgrow="ALWAYS">
            <!-- Trading chart controls -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="position-controls">
                <Label text="Position Trend Analysis" styleClass="chart-header-main"/>
                <Region HBox.hgrow="ALWAYS"/>
                
                <Label text="Position:" styleClass="control-label"/>
                <ComboBox fx:id="positionSelector" styleClass="position-selector"/>
                
                <Label text="Time Range:" styleClass="control-label"/>
                <ComboBox fx:id="timeRangeSelector" styleClass="time-range-selector"/>
                
                <Label text="Chart Type:" styleClass="control-label"/>
                <ComboBox fx:id="chartTypeSelector" styleClass="chart-type-selector"/>
                
                <Button fx:id="refreshChartBtn" text="🔄" onAction="#handleRefreshChart" styleClass="nav-button" minWidth="30" prefWidth="30">
                    <tooltip>
                        <Tooltip text="Refresh chart data"/>
                    </tooltip>
                </Button>
            </HBox>
            
            <!-- Trading chart placeholder -->
            <VBox fx:id="tradingChartPlaceholder" VBox.vgrow="ALWAYS" styleClass="trading-chart"/>
        </VBox>

        <!-- Segment Analysis Container (initially hidden) -->
        <VBox fx:id="segmentAnalysisContainer" spacing="10" style="-fx-padding: 10 0 0 0;" visible="false" managed="false" VBox.vgrow="ALWAYS">
            <!-- Segment controls -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Segment Analysis" styleClass="chart-header-main"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="segmentSummaryLabel" text="" styleClass="chart-header-sub"/>
            </HBox>
            
            <!-- Scrollable segment content -->
            <ScrollPane fx:id="segmentScrollPane" VBox.vgrow="ALWAYS" fitToWidth="true" style="-fx-background-color: transparent;">
                <VBox spacing="10">
                    <!-- Segment grid container -->
                    <VBox fx:id="segmentGridContainer" spacing="5" styleClass="segment-grid-container"/>
                    
                    <!-- Segment recommendations -->
                    <VBox fx:id="segmentRecommendationsContainer" spacing="5" styleClass="recommendations-container"/>
                </VBox>
            </ScrollPane>
        </VBox>

    </VBox>
</AnchorPane>